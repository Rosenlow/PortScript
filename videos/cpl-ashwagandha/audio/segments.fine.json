[
 {
  "start": 0.0,
  "end": 0.825,
  "text": "Gün bitiyor"
 },
 {
  "start": 0.966,
  "end": 2.79,
  "text": "ama zihnin hâlâ çalışıyor mu?"
 },
 {
  "start": 3.537,
  "end": 4.454,
  "text": "Yoğun tempo,"
 },
 {
  "start": 4.583,
  "end": 5.199,
  "text": "stres ve yarım kalan uykular."
 },
 {
  "start": 5.299,
  "end": 6.589,
  "text": "Aşvaganda,"
 },
 {
  "start": 7.349,
  "end": 10.925,
  "text": "yüzyıllardır kullanılan adaptojen bir bitki."
 },
 {
  "start": 11.542,
  "end": 13.134,
  "text": "Si Pi El Aşvaganda,"
 },
 {
  "start": 13.283,
  "end": 14.149,
  "text": "Ke Se Me altmış"
 },
 {
  "start": 14.262,
  "end": 17.438,
  "text": "altı kök ekstresiyle stresle başa çıkmana ve daha"
 },
 {
  "start": 17.602,
  "end": 19.801,
  "text": "dinlendirici bir uykuya destek olur."
 },
 {
  "start": 20.485,
  "end": 23.361,
  "text": "Altmış servis, günlük rutinine kolayca eklenir."
 },
 {
  "start": 23.915,
  "end": 26.16,
  "text": "Si Pi El Aşvaganda ile dengeni bul."
 }
]